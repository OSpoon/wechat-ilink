# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional Clerk authentication (configure both the frontend publishable key
# and this backend secret key to enable Clerk sign-in for API routes).
# Set authorized frontend origins in production, comma-separated.
# CLERK_SECRET_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
