{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".adonisjs/**"],
      "env": [
        "NODE_ENV",
        "APP_KEY",
        "APP_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "SESSION_DRIVER",
        "LIMITER_STORE",
        "ILINK_APP_ID",
        "ILINK_APP_CLIENT_VERSION",
        "ILINK_CHANNEL_VERSION",
        "ILINK_BOT_AGENT",
        "ILINK_BASE_URL",
        "ILINK_CDN_BASE_URL",
        "ILINK_BOT_TYPE",
        "MEDIA_STORAGE_PATH",
        "VITE_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "cache": false,
      "env": [
        "NODE_ENV",
        "APP_KEY",
        "APP_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "SESSION_DRIVER",
        "LIMITER_STORE",
        "ILINK_APP_ID",
        "ILINK_APP_CLIENT_VERSION",
        "ILINK_CHANNEL_VERSION",
        "ILINK_BOT_AGENT",
        "ILINK_BASE_URL",
        "ILINK_CDN_BASE_URL",
        "ILINK_BOT_TYPE",
        "MEDIA_STORAGE_PATH"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "NODE_ENV",
        "APP_KEY",
        "APP_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "SESSION_DRIVER",
        "LIMITER_STORE",
        "ILINK_APP_ID",
        "ILINK_APP_CLIENT_VERSION",
        "ILINK_CHANNEL_VERSION",
        "ILINK_BOT_AGENT",
        "ILINK_BASE_URL",
        "ILINK_CDN_BASE_URL",
        "ILINK_BOT_TYPE",
        "MEDIA_STORAGE_PATH"
      ]
    },
    "lint:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "NODE_ENV",
        "APP_KEY",
        "APP_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "SESSION_DRIVER",
        "LIMITER_STORE",
        "ILINK_APP_ID",
        "ILINK_APP_CLIENT_VERSION",
        "ILINK_CHANNEL_VERSION",
        "ILINK_BOT_AGENT",
        "ILINK_BASE_URL",
        "ILINK_CDN_BASE_URL",
        "ILINK_BOT_TYPE",
        "MEDIA_STORAGE_PATH"
      ]
    }
  }
}
